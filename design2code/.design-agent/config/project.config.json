{
  "name": "ghdi-design-md-harness",
  "targetStack": "Vue2 + Element UI",
  "workspaceRoot": ".",
  "componentCodebaseRoot": "",
  "componentRoot": "",
  "knownCodebases": {
    "bigboss-base": "",
    "bigboss-wedo": ""
  },
  "pathPolicy": {
    "persistedPathFormat": "repo-relative",
    "externalRepoPathFormat": "<repo-name>/<path-from-repo-root>",
    "localAbsolutePaths": "runtime-only"
  },
  "sourceDesignSeeds": [
    "seed/design.md",
    "seed/Component.md",
    "seed/theme-color-logic.md",
    "seed/page-designs"
  ],
  "designIndexRoot": ".repo-design-index",
  "taskOutputRoot": ".codex-task",
  "defaultPageTypes": [
    "list-management-page",
    "config-management-page"
  ],
  "preferredComponents": [
    "baseTableV2",
    "File",
    "SearchSelectUser",
    "newSelectDepart",
    "EditorVue",
    "UTag",
    "actionTitle"
  ]
}
